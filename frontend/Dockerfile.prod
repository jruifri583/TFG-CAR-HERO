# ============================================
# STAGE 1 — Build (Node 20)
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar manifiestos para cachear dependencias
COPY package.json package-lock.json ./
RUN npm ci

# Copiar código fuente
COPY . .

# Variables de entorno de build (se inyectan desde docker-compose)
ARG VITE_API_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_TURNSTILE_SITE_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

# Generar bundle de producción
RUN npm run build

# ============================================
# STAGE 2 — Serve (Nginx Alpine)
# ============================================
FROM nginx:1.27-alpine

# Eliminar config por defecto de Nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiar nuestra configuración personalizada
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar el build de React desde la etapa anterior
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
