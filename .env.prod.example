# =============================================================================
#  CAR-HERO — Variables de entorno para PRODUCCIÓN (AWS Academy)
# =============================================================================
#  Copia este fichero como .env.prod y rellena los valores reales.
#  NUNCA subas este fichero con secretos reales a Git.
#
#  Dominio: carhero.duckdns.org (DuckDNS gratuito)
# =============================================================================

# ── Aplicación Laravel ──
APP_KEY=base64:GENERA_UNA_CLAVE_NUEVA_CON_php_artisan_key_generate
APP_URL=https://carhero.duckdns.org
FRONTEND_URL=https://carhero.duckdns.org
SANCTUM_STATEFUL_DOMAINS=carhero.duckdns.org

# ── Base de datos (MySQL) ──
MYSQL_DATABASE=carhero_prod
MYSQL_USER=carhero_user
MYSQL_PASSWORD=CAMBIA_ESTA_PASSWORD_SEGURA
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_ROOT_PASSWORD

# ── Google OAuth (Backend — verificación del id_token) ──
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REDIRECT_URI=https://carhero.duckdns.org/api/auth/google/callback

# ── Google OAuth (Frontend — widget de login, build arg de Vite) ──
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── Resend (Email API) ──
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAIL_FROM_ADDRESS=noreply@carhero.duckdns.org
MAIL_FROM_NAME="CAR-HERO"

# ── Cloudflare Turnstile (Anti-spam) ──
VITE_TURNSTILE_SITE_KEY=tu-site-key-publica
TURNSTILE_SECRET_KEY=tu-secret-key-privada
